iters=100000 runs=15
warmup_runs=3
bootstrap_samples=20000
bench_suites=kyber_upstream_avx2,kyber_upstream_avx2_fair,mlkem_native,pqclean_avx2,liboqs,boringssl,libcrux_rust,libjade_kyber768_avx2,botan_mlkem,openssl_mlkem
local_AVX2_BACKEND=core (Makefile default)
PIN_CPU=0
C_COMPILER=clang
CXX_COMPILER=/usr/bin/clang++
gcc_install_dir=/usr/lib/gcc/x86_64-linux-gnu/13
UPDATE_REPOS=1
git_repos_preupdated=1
allow_cached_comparator=0
stats_mode=median
trim_count=1
local_bench_reuse=1
skip_local_build=1
local_bench_bin=/home/kishiguro/fun/baby-mlkem/bench_productc
local_roundtrip_metric=mlkem_roundtrip_core_ns_per_op
bench_isa_profile=native
bench_profile_tag=goal-native
local_OPT_CFLAGS=-O3 -fno-semantic-interposition -fvisibility=hidden
local_EXTRA_CFLAGS=-fomit-frame-pointer -fno-stack-protector -falign-loops=64 -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-strict-aliasing
local_ARCH_CFLAGS=-march=native
local_ASFLAGS=-Wa,--noexecstack
mlkem_native_auto=1
mlkem_native_cflags=-march=native -mavx2 -mbmi2 -mpopcnt -maes
mlkem_native_harness_cflags=-O3 -march=native -mavx2 -mbmi2 -mpopcnt -maes -fomit-frame-pointer -std=c99
upstream_cflags=-O3 -march=native -mavx2 -mbmi2 -mpopcnt -fomit-frame-pointer -std=c99
pqclean_clean_cflags=-O3 -march=native -std=c99
pqclean_avx2_cflags=-mavx2 -mbmi2 -mpopcnt -O3 -Wall -Wextra -Wpedantic -Werror -Wmissing-prototypes -Wredundant-decls -Wpointer-arith -Wshadow -std=c99 -I../../../common
pqclean_harness_cflags=-O3 -march=native -mavx2 -mbmi2 -mpopcnt -std=c99
liboqs_dist_build=OFF
liboqs_opt_target=native
liboqs_cflags=-O3 -march=native
liboqs_harness_cflags=-O3 -march=native
boringssl_c_flags=-O3 -march=native
boringssl_cxx_flags=-O3 -march=native --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/13
boringssl_harness_flags=-O3 -march=native
libcrux_rustflags=-C target-cpu=native -C codegen-units=1
libcrux_crate_version=0.0.10
libcrux_harness_cflags=-O3 -march=native
libjade_harness_cflags=-D_GNU_SOURCE -O3 -march=native -mavx2 -mbmi2 -mpopcnt -fomit-frame-pointer -std=c99
botan_adapter_mode=internal-core-direct
botan_cache_policy=wire-key-parse-and-operation-rebuild-per-call
botan_modules=ml_kem,keccak_perm_bmi2
botan_cxx=/usr/bin/clang++
botan_cc_family=clang
botan_compiler_pairing=required
botan_cxxflags=-O3 -march=native -mavx2 -mbmi2 -mpopcnt -fomit-frame-pointer -fno-semantic-interposition --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/13
botan_disabled_modules=<none>
botan_harness_cflags=-O3 <profile ARCH_CFLAGS> -fomit-frame-pointer -fno-stack-protector -std=c11
botan_harness_cxxflags=-O3 -march=native --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/13
openssl_cflags=-O3 -fno-semantic-interposition -march=native -mavx2 -mbmi2 -mpopcnt
openssl_harness_cflags=-O3 -march=native
openssl_ia32cap=<unset>
effective_local_OPT_CFLAGS=-O3 -fno-semantic-interposition -fvisibility=hidden
effective_local_EXTRA_CFLAGS=-fomit-frame-pointer -fno-stack-protector -falign-loops=64 -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-strict-aliasing
fair_upstream_cflags=-O3 -fno-semantic-interposition -fvisibility=hidden -march=native -mavx2 -mbmi2 -mpopcnt -fomit-frame-pointer -fno-stack-protector -falign-loops=64 -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-strict-aliasing -std=c99

