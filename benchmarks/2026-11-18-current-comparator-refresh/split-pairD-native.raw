[kyber_upstream_avx2] run=3/4 order=local-first
[kyber_upstream_avx2] run=3 keygen=3909.91/5178.87 encaps=3488.96/5060.05 decaps=2813.02/5649.44 roundtrip=10355.61/16083.52
